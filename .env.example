# EDGE Content Engine Environment Configuration

# LLM Providers (At least one required)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage & AWS Configuration
EDGE_ENV=local                    # local | dev | prod
AWS_REGION=us-east-1
S3_CONTENT_BUCKET=edge-content-lake
DATABASE_URL=sqlite:///./content/edge.db  # or postgresql://user:pass@localhost:5432/edge

# GitHub Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Beehiiv Publication Integration
BEEHIIV_API_TOKEN=
BEEHIIV_PUBLICATION_ID=

# Social API Credentials (Optional - manual approval enforced by default)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=

# Model Budget & Execution Controls
MAX_LLM_COST_PER_ARTICLE=2.50
MAX_RESEARCH_SOURCES=20
MAX_REVISION_LOOPS=3
AUTO_RESEARCH_SCORE_THRESHOLD=48
